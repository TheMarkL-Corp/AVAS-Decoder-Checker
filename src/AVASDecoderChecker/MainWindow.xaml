<Window x:Class="AVASDecoderChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AVASDecoderChecker"
        mc:Ignorable="d"
        Title="AVAS SDVoE Decoder Stream Checker"
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Grid>
        <!-- Main Layout Rows: Header, Content Body, Footer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP APP BAR ================= -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBlue}" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="AV" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AVAS SDVoE Decoder Stream Checker" Style="{StaticResource HeaderTitle}" FontSize="18"/>
                        <TextBlock Text="Hardware Telemetry, HDMI Sync Lock &amp; CSV Diagnostic Monitor" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badges & Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Server Status Badge -->
                    <Border Background="#1E293B" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding ConnectionStatusLevel, Converter={StaticResource StatusToColorConverter}}"/>
                            <TextBlock Text="Server: " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{Binding ConnectionStatusLevel, Converter={StaticResource StatusToColorConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Test State Badge -->
                    <Border Background="#1E293B" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Test State: " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="{Binding TestStatusText}" FontWeight="Bold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTestRunning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Elapsed Time Display -->
                    <Border Background="#1E293B" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Elapsed: " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="{Binding ElapsedTimeText}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Open Logs Folder Button -->
                    <Button Content="📁 Open Logs Folder" Style="{StaticResource BtnSecondary}" Command="{Binding OpenLogsFolderCommand}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT BODY ================= -->
        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="340" MaxWidth="500"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Server Settings & Decoder Selection -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CARD 1: CONTROL SERVER SETTINGS -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- Header with Lock Status Badge -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1. Control Server Settings" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>

                            <!-- Lock / Unlock Indicator Badge -->
                            <Border Grid.Column="1" CornerRadius="12" Padding="8,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsLocked}" Value="True">
                                                <Setter Property="Background" Value="#064E3B"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="🔓 Editable"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSettingsLocked}" Value="True">
                                                        <Setter Property="Text" Value="🔒 Saved &amp; Locked"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- IP & Port Inputs -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Control Server IP" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditServerSettings}"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="HTTP Port" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditServerSettings}"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Polling Interval & Duration -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Polling Interval (s)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PollingInterval, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditServerSettings}"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Duration (min, 0=inf)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditServerSettings}"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Settings Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Test Connection" Style="{StaticResource BtnSecondary}"
                                    Command="{Binding TestConnectionCommand}"/>

                            <!-- When not locked: Save & Verify button -->
                            <Button Grid.Column="2" Content="Save &amp; Verify"
                                    Command="{Binding SaveSettingsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsLocked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- When locked: Edit Settings button -->
                            <Button Grid.Column="2" Content="🔓 Edit Settings"
                                    Command="{Binding UnlockSettingsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsLocked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- PROMINENT IN-CARD CONNECTION STATUS BANNER -->
                        <Border Margin="0,12,0,0" CornerRadius="6" Padding="12,10"
                                Visibility="{Binding HasConnectionBanner, Converter={StaticResource BoolToVisConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#172234"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionBannerLevel}" Value="SUCCESS">
                                            <Setter Property="Background" Value="#064E3B"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionBannerLevel}" Value="ERROR">
                                            <Setter Property="Background" Value="#7F1D1D"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionBannerLevel}" Value="INFO">
                                            <Setter Property="Background" Value="#1E3A8A"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding ConnectionBannerTitle}" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding ConnectionBannerDetails}" FontSize="12"
                                           Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CARD 2: TARGET DECODERS (RX) SELECTION -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header & Counts -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="2. Select Decoders (RX)" Style="{StaticResource CardTitle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Selected: " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedDecodersCount}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text=" / " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                <TextBlock Text="{Binding TotalDecodersCount}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Search Filter -->
                        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"
                                 Tag="Search by name, MAC or IP..."/>

                        <!-- Action Toolbar -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Select All" Style="{StaticResource BtnSecondary}"
                                    Command="{Binding SelectAllCommand}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="Clear" Style="{StaticResource BtnSecondary}"
                                    Command="{Binding DeselectAllCommand}" Padding="8,4" FontSize="11"/>
                            <Button Grid.Column="3" Content="🔄 Query Network" Style="{StaticResource BtnSecondary}"
                                    Command="{Binding QueryDecodersCommand}" Padding="8,4" FontSize="11"/>
                        </Grid>

                        <Grid Grid.Row="3">
                            <!-- Decoders Selection DataGrid -->
                            <DataGrid ItemsSource="{Binding Decoders}"
                                      Style="{StaticResource ModernDataGrid}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <!-- Checkbox Column -->
                                    <DataGridTemplateColumn Width="45">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Decoder Name -->
                                    <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="*"/>

                                    <!-- MAC Address -->
                                    <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="130"
                                                        FontFamily="Consolas, monospace" FontSize="11"/>

                                    <!-- Status Badge -->
                                    <DataGridTemplateColumn Header="Status" Width="65">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#064E3B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Background" Value="#7F1D1D"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="ON"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                        <Setter Property="Text" Value="OFF"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Prompt when no decoders discovered yet -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource BorderCard}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalDecodersCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📡 No Decoders Loaded Yet" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Click 'Save &amp; Verify' or 'Query Network' above to discover all SDVoE decoders on your network."
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Width="280"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: Live Results Dashboard & Logs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- KPI Summary Cards -->
                    <RowDefinition Height="Auto"/>
                    <!-- Test Action Control Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Upstream TX Pipeline Status Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Live Telemetry Results DataGrid -->
                    <RowDefinition Height="3*"/>
                    <!-- Splitter -->
                    <RowDefinition Height="8"/>
                    <!-- Live Activity Log -->
                    <RowDefinition Height="2*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: KPI SUMMARY CARDS -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Monitored Decoders -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0">
                        <StackPanel>
                            <TextBlock Text="MONITORED RX" Style="{StaticResource LabelStyle}" FontSize="11"/>
                            <TextBlock Text="{Binding KpiMonitoredDecoders}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="22" Margin="0,4,0,0"/>
                            <TextBlock Text="Active in Test" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Q1 - Video From Encoder -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0" BorderBrush="#1E40AF">
                        <StackPanel>
                            <TextBlock Text="1. VIDEO FROM ENCODER" Style="{StaticResource LabelStyle}" Foreground="#93C5FD" FontSize="11" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KpiVideoReceivedCount}" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="22"/>
                                <TextBlock Text=" Receiving" Foreground="{StaticResource AccentGreen}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding KpiNoVideoCount}" Foreground="{StaticResource AccentRed}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text=" No Stream / Down" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Q2 - Display Screen Status -->
                    <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0" BorderBrush="#065F46">
                        <StackPanel>
                            <TextBlock Text="2. DISPLAY SCREEN STATUS" Style="{StaticResource LabelStyle}" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KpiDisplaysActiveCount}" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="22"/>
                                <TextBlock Text=" Displaying" Foreground="{StaticResource AccentGreen}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding KpiDisplaysIssueCount}" Foreground="{StaticResource AccentAmber}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text=" Off / Disconnected" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Anomalies (>2.0s Post-Reboot / Midstream Blackouts) -->
                    <Border Grid.Column="6" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0" BorderBrush="#7E22CE">
                        <StackPanel>
                            <TextBlock Text="ANOMALIES (&gt;2.0s)" Style="{StaticResource LabelStyle}" Foreground="#C084FC" FontSize="11" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KpiAnomalyCount}" Foreground="#C084FC" FontWeight="Bold" FontSize="22"/>
                                <TextBlock Text=" Incidents" Foreground="#C084FC" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                            <TextBlock Text="Dropout / Timeout" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 5: Total Cycles / Samples -->
                    <Border Grid.Column="8" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0">
                        <StackPanel>
                            <TextBlock Text="TEST CYCLES" Style="{StaticResource LabelStyle}" FontSize="11"/>
                            <TextBlock Text="{Binding KpiTotalSamples}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="22" Margin="0,4,0,0"/>
                            <TextBlock Text="Telemetry Polled" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 6: Health Pass Rate -->
                    <Border Grid.Column="10" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0">
                        <StackPanel>
                            <TextBlock Text="PASS RATE" Style="{StaticResource LabelStyle}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding KpiHealthPercentage}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="22"/>
                                <TextBlock Text="%" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KpiPassingCount, StringFormat='{}{0} Passes'}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ROW 1: TEST ACTION CONTROL BAR -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Start Test Button -->
                        <Button Grid.Column="0" Content="▶ START TEST" Style="{StaticResource BtnSuccess}"
                                Command="{Binding StartTestCommand}"
                                Padding="20,10" FontSize="14" FontWeight="Bold"/>

                        <!-- Stop Test Button -->
                        <Button Grid.Column="2" Content="⏹ STOP TEST" Style="{StaticResource BtnDanger}"
                                Command="{Binding StopTestCommand}"
                                Padding="20,10" FontSize="14" FontWeight="Bold"/>

                        <!-- Session Directory Path -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="Current Run Log Directory:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <TextBlock Text="{Binding CurrentSessionDir, TargetNullValue='None (Test not running)'}"
                                       Foreground="{StaticResource TextPrimary}" FontWeight="Medium" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 2: UPSTREAM TRANSMITTER (TX) PIPELINE STATUS BAR -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,12" Background="#131B2E" BorderBrush="#3B82F6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                <TextBlock Text="UPSTREAM TX" FontWeight="Bold" FontSize="11" Foreground="#93C5FD"/>
                            </Border>
                            <Border CornerRadius="4" Padding="6,3"
                                    Background="{Binding EncoderOverallStatus, Converter={StaticResource StatusToBgBrushConverter}}"
                                    BorderBrush="{Binding EncoderOverallStatus, Converter={StaticResource StatusToColorConverter}}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding EncoderOverallStatus}" FontWeight="Bold" FontSize="11"
                                           Foreground="{Binding EncoderOverallStatus, Converter={StaticResource StatusToColorConverter}}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Source: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding EncoderStatusText}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock Text="TX MAC: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding EncoderMacText}" FontFamily="Consolas, monospace" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock Text="Raster: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding EncoderRasterText}" FontFamily="Consolas, monospace" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Temp: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding EncoderTempText}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                            <Border Background="#2E1065" CornerRadius="4" Padding="6,2" BorderBrush="#7E22CE" BorderThickness="1">
                                <TextBlock Text="⏱ Recovery Window: 2.0s" Foreground="#C084FC" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 3: LIVE TELEMETRY RESULTS DATAGRID -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BgCardHeader}" Padding="16,10" CornerRadius="8,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="3. Live Decoder Verification &amp; Diagnostics" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text=" (Click any row to open Hardware Inspector below)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Live SDVoE Telemetry" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding LiveTelemetry}"
                                  SelectedItem="{Binding SelectedTelemetryRow, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Style="{StaticResource ModernDataGrid}"
                                  RowHeight="NaN" MinRowHeight="52"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <!-- Overall Verdict -->
                                <DataGridTemplateColumn Header="VERDICT" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{Binding OverallStatus, Converter={StaticResource StatusToBgBrushConverter}}"
                                                    BorderBrush="{Binding OverallStatus, Converter={StaticResource StatusToColorConverter}}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding OverallStatus}"
                                                           Foreground="{Binding OverallStatus, Converter={StaticResource StatusToColorConverter}}"
                                                           FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Decoder Identity -->
                                <DataGridTemplateColumn Header="DECODER (RX)" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                <TextBlock Text="{Binding DecoderName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                                                <TextBlock Text="{Binding MacAddress}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Text="{Binding IpAddress}" FontFamily="Consolas, monospace" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Question 1: Video From Encoder -->
                                <DataGridTemplateColumn Header="1. VIDEO FROM ENCODER" Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,3"
                                                        Background="{Binding Question1Badge, Converter={StaticResource StatusToBgBrushConverter}}"
                                                        BorderBrush="{Binding Question1Badge, Converter={StaticResource StatusToColorConverter}}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Question1Badge}"
                                                               Foreground="{Binding Question1Badge, Converter={StaticResource StatusToColorConverter}}"
                                                               FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding Question1Details}" FontSize="11" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding VideoRaster}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Question 2: Display Screen Status -->
                                <DataGridTemplateColumn Header="2. DISPLAY SCREEN STATUS" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,3"
                                                        Background="{Binding Question2Badge, Converter={StaticResource StatusToBgBrushConverter}}"
                                                        BorderBrush="{Binding Question2Badge, Converter={StaticResource StatusToColorConverter}}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Question2Badge}"
                                                               Foreground="{Binding Question2Badge, Converter={StaticResource StatusToColorConverter}}"
                                                               FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding Question2Details}" FontSize="11" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="HPD: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding IsHpdConnected, Converter={StaticResource BoolToColorConverter}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Connected"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHpdConnected}" Value="False">
                                                                        <Setter Property="Text" Value="Disconnected"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text=" | TMDS: " FontSize="10" Foreground="{StaticResource TextMuted}" Margin="4,0,0,0"/>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding IsTmdsClockActive, Converter={StaticResource BoolToColorConverter}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Active"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTmdsClockActive}" Value="False">
                                                                        <Setter Property="Text" Value="Inactive"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Anomaly & Recovery Latency -->
                                <DataGridTemplateColumn Header="RECOVERY &amp; ANOMALY" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                <Border CornerRadius="3" Padding="5,2" HorizontalAlignment="Left" Margin="0,0,0,2"
                                                        Background="{Binding OverallStatus, Converter={StaticResource StatusToBgBrushConverter}}"
                                                        BorderBrush="{Binding OverallStatus, Converter={StaticResource StatusToColorConverter}}"
                                                        BorderThickness="1">
                                                    <TextBlock FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="NORMAL"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnomaly}" Value="True">
                                                                        <Setter Property="Text" Value="⚠️ ANOMALY"/>
                                                                        <Setter Property="Foreground" Value="#C084FC"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="TX: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding SourceEncoderStatus}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Recov: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding RecoveryTimeSec, StringFormat='{}{0:F1}s'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{StaticResource TextPrimary}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Fault Attribution / Root Cause Isolation -->
                                <DataGridTemplateColumn Header="FAULT ATTRIBUTION" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left"
                                                        Background="{Binding FaultAttribution, Converter={StaticResource StatusToBgBrushConverter}}"
                                                        BorderBrush="{Binding FaultAttribution, Converter={StaticResource StatusToColorConverter}}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding FaultAttribution}"
                                                               Foreground="{Binding FaultAttribution, Converter={StaticResource StatusToColorConverter}}"
                                                               FontWeight="Bold" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Diagnostic Notes / Analysis -->
                                <DataGridTemplateColumn Header="DIAGNOSTIC VERDICT &amp; REASONING" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Notes}" VerticalAlignment="Center" Margin="4,2"
                                                        TextWrapping="Wrap" FontSize="11" LineHeight="15" Foreground="#CBD5E1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Last Timestamp -->
                                <DataGridTextColumn Header="UPDATED" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="80"
                                                    FontFamily="Consolas, monospace" FontSize="11"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ROW 4: Grid Splitter -->
                <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{StaticResource BorderCard}"/>

                <!-- ROW 5: TABBED INSPECTOR & ACTIVITY LOG -->
                <Border Grid.Row="5" Style="{StaticResource CardBorder}" Padding="0" Margin="0">
                    <TabControl Style="{StaticResource ModernTabControl}" Margin="8,4,8,8">
                        <!-- TAB 1: HARDWARE INSPECTOR -->
                        <TabItem Header="🔬 Hardware Diagnostic Inspector" Style="{StaticResource ModernTabItem}">
                            <Grid Margin="0,8,0,0">
                                <!-- Prompt when no row is selected -->
                                <Border Background="#121B2D" CornerRadius="6" Padding="20"
                                        Visibility="{Binding SelectedTelemetryRow, Converter={StaticResource InverseNullToVisConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="👈 Select any decoder row in the table above" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Displays full physical layer breakdown: Hot-Plug Detect (HPD) pin, VESA EDID decode, TMDS pixel clock, genlock sync, HDCP blanking, and multicast route."
                                                   FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Inspector Detail View when a row is selected -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding SelectedTelemetryRow, Converter={StaticResource NullToVisConverter}}">
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Panel A: Decoder Identity -->
                                        <Border Grid.Column="0" Background="#141E30" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="DECODER IDENTITY" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding SelectedTelemetryRow.DecoderName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding SelectedTelemetryRow.MacAddress}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource AccentBlue}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding SelectedTelemetryRow.IpAddress}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource TextSecondary}"/>

                                                <Separator Background="{StaticResource BorderCard}" Margin="0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Device Type: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Text="SDVoE Receiver (RX)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="Session Samples: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedTelemetryRow.SampleCount}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="Chip Temp: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedTelemetryRow.TemperatureC, StringFormat='{}{0:F1} °C', TargetNullValue='N/A'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="IP Mode: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedTelemetryRow.NetworkIpMode, TargetNullValue='UNKNOWN'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="Network Port: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedTelemetryRow.NetworkPortSpeed, TargetNullValue='10G'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="Fault Status: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedTelemetryRow.FaultAttribution, TargetNullValue='NONE'}" FontWeight="SemiBold"
                                                               Foreground="{Binding SelectedTelemetryRow.FaultAttribution, Converter={StaticResource StatusToColorConverter}}" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Panel B: Question 1 Details (Inbound Stream) -->
                                        <Border Grid.Column="2" Background="#141E30" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="QUESTION 1: INBOUND STREAM (ENCODER → RX)" FontWeight="Bold" FontSize="11" Foreground="#93C5FD" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Video Rx Status:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.VideoReceivedStatus}" FontWeight="Bold"
                                                               Foreground="{Binding SelectedTelemetryRow.VideoReceivedStatus, Converter={StaticResource StatusToColorConverter}}" FontSize="11"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Source Encoder TX:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.SourceEncoderMac}" FontFamily="Consolas, monospace" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Multicast IP:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.MulticastAddress}" FontFamily="Consolas, monospace" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Clock Recovery (Genlock):" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding SelectedTelemetryRow.IsClockStable, Converter={StaticResource BoolToColorConverter}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Locked (Stable)"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedTelemetryRow.IsClockStable}" Value="False">
                                                                        <Setter Property="Text" Value="UNLOCKED (Jitter / Lost)"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Stream Raster:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.VideoRaster}" FontFamily="Consolas, monospace" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Pixel Clock:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.PixelClockMhz, StringFormat='{}{0:F2} MHz'}" FontFamily="Consolas, monospace" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Multi-Link Sync:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.MultiLinkStatus, TargetNullValue='N/A'}" FontFamily="Consolas, monospace" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Panel C: Question 2 Details (Outbound Display) -->
                                        <Border Grid.Column="4" Background="#141E30" BorderBrush="#064E3B" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="QUESTION 2: PHYSICAL DISPLAY (RX → SINK)" FontWeight="Bold" FontSize="11" Foreground="#6EE7B7" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Screen Status:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.DisplayScreenStatus}" FontWeight="Bold"
                                                               Foreground="{Binding SelectedTelemetryRow.DisplayScreenStatus, Converter={StaticResource StatusToColorConverter}}" FontSize="11"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Hot-Plug (HPD Pin):" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding SelectedTelemetryRow.IsHpdConnected, Converter={StaticResource BoolToColorConverter}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="HIGH (Display Cable Connected)"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedTelemetryRow.IsHpdConnected}" Value="False">
                                                                        <Setter Property="Text" Value="LOW (No Cable / Display Off)"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Display Model (EDID):" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.DisplayModelName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Display Serial Number:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.DisplaySerialNumber}" FontFamily="Consolas, monospace" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="TMDS Clock Output:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding SelectedTelemetryRow.IsTmdsClockActive, Converter={StaticResource BoolToColorConverter}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="ACTIVE (Pushing Pixels)"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedTelemetryRow.IsTmdsClockActive}" Value="False">
                                                                        <Setter Property="Text" Value="INACTIVE (No Video Output)"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="HDCP Blanking:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="None (Unencrypted / Passing)"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedTelemetryRow.IsHdcpBlocked}" Value="True">
                                                                        <Setter Property="Text" Value="BLOCKED (Screen Black / Blanked)"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Fault Attribution:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTelemetryRow.FaultAttribution, TargetNullValue='NONE'}" FontWeight="Bold"
                                                               Foreground="{Binding SelectedTelemetryRow.FaultAttribution, Converter={StaticResource StatusToColorConverter}}" FontSize="11"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: ACTIVITY LOG -->
                        <TabItem Header="📜 Event &amp; Activity Log" Style="{StaticResource ModernTabItem}">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="Real-Time Operation &amp; CSV Log Trace" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                    <Button HorizontalAlignment="Right" Content="Clear Log" Style="{StaticResource BtnSecondary}"
                                            Command="{Binding ClearLogsCommand}" Padding="8,2" FontSize="11"/>
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLogs}"
                                         Background="#0A0F1D" Foreground="#A5B4FC"
                                         FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="12"
                                         BorderThickness="1" BorderBrush="{StaticResource BorderCard}" Padding="10,6"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= BOTTOM STATUS FOOTER ================= -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Ready - Strict Live Mode (SDVoE Network Connected)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="AVAS Decoder Checker v1.0.2 (.NET 8.0)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ================= BUSY / LOADING OVERLAY ================= -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#AA0B1120"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1"
                    CornerRadius="10" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16" Foreground="{StaticResource AccentBlue}"/>
                    <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
